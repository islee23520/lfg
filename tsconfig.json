{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "src/cli/**/*.ts",
    "src/grok-adapter/**/*.ts",
    "src/test-utils/**/*.ts"
  ],
  "exclude": [
    "dist"
  ]
}
