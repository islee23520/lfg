{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "types": ["bun-types"],
    "strict": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@oh-my-opencode/*": [
        "plugins/lfg/vendor-links/*/index.ts",
        "plugins/lfg/vendor/omo-standalone/packages/*/src/index.ts"
      ]
    }
  }
}
