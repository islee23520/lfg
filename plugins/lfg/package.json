{
  "name": "lfg",
  "version": "0.1.0",
  "type": "module",
  "description": "Installs the lazycodex Codex adapter for grok-build.",
  "bin": {
    "lfg": "./dist/lfg.js",
    "lfg-mcp": "./dist/lfg-mcp.js"
  },
  "exports": {
    ".": "./dist/lfg.js",
    "./cli": "./dist/lfg.js",
    "./mcp": "./dist/lfg-mcp.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs",
    "postinstall": "node -e \"console.log('LFG lazycodex adapter installer postinstall: no-op')\"",
    "test": "npm run build && vitest run ./bin/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.14"
  }
}
