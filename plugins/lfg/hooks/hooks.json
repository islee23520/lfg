{
  "hooks": {
    "comment": "LFG Active Goal Harness is the aggressive per-turn injector. Audit is kept for observability.",
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-audit-hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-goal-harness.ts",
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-audit-hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-goal-harness.ts",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-audit-hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-goal-harness.ts",
            "timeout": 12
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-goal-harness.ts",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-audit-hook.ts",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/lfg-audit-hook.ts",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
