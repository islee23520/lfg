{
  "name": "@islee23520/lfg",
  "version": "0.1.3",
  "description": "omo / lazycodex Grok Build adapter: npx @islee23520/lfg setup --run installs ~/.grok via internal grok-install (not a Grok plugin).",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "islee23520",
    "email": "lysk9884@gmail.com"
  },
  "type": "module",
  "bin": {
    "lfg": "plugins/lfg/lfg"
  },
  "files": [
    "plugins/lfg/AGENTS.md",
    "plugins/lfg/lfg",
    "plugins/lfg/README.md",
    "plugins/lfg/dist",
    "plugins/lfg/skills"
  ],
  "keywords": [
    "lazycodex",
    "grok-build",
    "npx",
    "setup"
  ],
  "workspaces": [
    "plugins/lfg"
  ],
  "scripts": {
    "setup": "sh plugins/lfg/lfg setup",
    "test": "npm run build && vitest run plugins/lfg/bin/*.test.ts plugins/lfg/grok-install/*.test.ts",
    "self-test": "npm run build && node plugins/lfg/dist/self-test.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.14"
  }
}
