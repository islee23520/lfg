{
  "name": "@islee23520/lfg",
  "version": "0.1.27",
  "description": "OpenCode OmO / lazycodex GrokBuild port: npx @islee23520/lfg setup --run installs the lfg-owned Grok Build plugin payload under ~/.grok/plugins/lfg.",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "islee23520",
    "email": "lysk9884@gmail.com"
  },
  "type": "module",
  "bin": {
    "lfg": "bin/lfg.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "AGENTS.md",
    "src/AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/islee23520/lfg.git"
  },
  "homepage": "https://github.com/islee23520/lfg#readme",
  "bugs": {
    "url": "https://github.com/islee23520/lfg/issues"
  },
  "keywords": [
    "lazycodex",
    "grok-build",
    "npx",
    "setup"
  ],
  "scripts": {
    "setup": "sh bin/lfg.js setup",
    "doctor": "sh bin/lfg.js doctor",
    "test": "npm run build && vitest run src/cli/*.test.ts src/cli/**/*.test.ts src/core/*.test.ts src/core/**/*.test.ts src/grok/*.test.ts src/grok/**/*.test.ts --exclude src/grok/skills/**/*.test.ts",
    "test:ulw-loop": "vitest run src/core/omo/ulw-loop src/cli/ulw-loop src/cli/feature-coverage.inventory.test.ts",
    "coverage:ulw-loop": "vitest run --coverage src/core/omo/ulw-loop src/cli/ulw-loop src/cli/feature-coverage.inventory.test.ts",
    "verify": "npm run assert-pack && npm run assert-omo-parity && npm run assert-skills-smoke && npm test && npm run coverage:ulw-loop && npm run typecheck && npm run self-test",
    "self-test": "npm run build && node dist/self-test.js",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "assert-omo-parity": "npm run build && node scripts/assert-omo-parity.mjs",
    "assert-skills-smoke": "node scripts/assert-skills-smoke.mjs",
    "assert-pack": "npm run build && node scripts/assert-npm-pack-bin.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "zod": "^4.4.3"
  }
}
